<Window x:Class="Ordinis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Ordinis.Views.Controls"
        xmlns:pages="clr-namespace:Ordinis.Views.Pages"
        xmlns:vm="clr-namespace:Ordinis.ViewModels"
        xmlns:core="clr-namespace:Ordinis.Core"
        Title="Ordinis — Microsoft Ecosystem Security Suite"
        Height="820" Width="1280" MinHeight="700" MinWidth="1050"
        Background="{StaticResource OrdinisBackground}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- ══ SIDEBAR ══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                Background="{StaticResource OrdinisSidebar}">
            <DockPanel>
                <!-- Logo / branding -->
                <Border DockPanel.Dock="Top" Padding="20,24,20,16"
                        BorderThickness="0,0,0,1" BorderBrush="#1F2235">
                    <StackPanel>
                        <TextBlock Text="ORDINIS"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Security Suite"
                                   FontSize="11" Foreground="#6B7280"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Target display -->
                <Border DockPanel.Dock="Top" Padding="16,10" Margin="8,8,8,0"
                        Background="#1A1B2E" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="TARGET" FontSize="9" Foreground="#4B5563"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Target.DisplayName}"
                                   FontSize="12" Foreground="#D1D5DB"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Nav section label -->
                <TextBlock DockPanel.Dock="Top" Text="NAVIGATION"
                           FontSize="9" Foreground="#4B5563"
                           Margin="20,16,0,6"/>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateDashboard}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateFindings}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldSearch" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Findings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateGpo}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="GPO Manager" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateBackups}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Backups" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateReports}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLine" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Reports" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Command="{Binding NavigateSettings}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom: about -->
                <Border DockPanel.Dock="Bottom" Padding="16,12"
                        BorderThickness="0,1,0,0" BorderBrush="#1F2235">
                    <StackPanel>
                        <TextBlock Text="{x:Static core:AppInfo.Edition}"
                                   FontSize="10" Foreground="#4B5563"/>
                        <TextBlock Text="github.com/RohanFox"
                                   FontSize="10" Foreground="#4B5563"/>
                    </StackPanel>
                </Border>

                <Grid/>
            </DockPanel>
        </Border>

        <!-- ══ MAIN AREA ════════════════════════════════════════════════════════ -->
        <DockPanel Grid.Column="1" Grid.Row="0">

            <!-- Top bar -->
            <Border DockPanel.Dock="Top"
                    Background="{StaticResource OrdinisTopBar}"
                    Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profile selector + target -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Profile:" Foreground="#6B7280"
                                   VerticalAlignment="Center" FontSize="13" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="Name"
                                  Width="220" Margin="0,0,12,0"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Select profile"/>

                        <Button Content="+ Remote Target"
                                Command="{Binding NavigateSettings}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#6B7280" BorderBrush="#374151"
                                FontSize="12" Padding="10,4"/>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding RunScanCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource PrimaryHueMidBrush}"
                                Padding="16,8" Margin="0,0,10,0"
                                Visibility="{Binding IsNotLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlayCircle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Run Audit" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelScanCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#DC2626"
                                Padding="16,8" Margin="0,0,10,0"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Stop" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding FixSelectedCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="16,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Wrench" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Fix Selected" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NavigateReports}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileChart" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Report" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page content -->
            <ContentControl Content="{Binding CurrentPage}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                        <pages:DashboardPage/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:FindingsViewModel}">
                        <pages:FindingsPage/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:GpoViewModel}">
                        <pages:GpoPage/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:BackupViewModel}">
                        <pages:BackupPage/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ReportViewModel}">
                        <pages:ReportPage/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <pages:SettingsPage/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </DockPanel>

        <!-- ══ STATUS BAR ════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Grid.Row="1"
                Background="{StaticResource OrdinisTopBar}"
                BorderThickness="0,1,0,0" BorderBrush="#1F2235"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="#9CA3AF" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Foreground="#22C55E" FontSize="12" Margin="0,0,16,0">
                        <Run Text="PASS "/>
                        <Run Text="{Binding Session.PassCount, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="#EF4444" FontSize="12" Margin="0,0,16,0">
                        <Run Text="FAIL "/>
                        <Run Text="{Binding Session.FailCount, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="#F59E0B" FontSize="12" Margin="0,0,16,0">
                        <Run Text="ERR "/>
                        <Run Text="{Binding Session.ErrorCount, Mode=OneWay}"/>
                    </TextBlock>
                    <ProgressBar Value="{Binding Progress}"
                                 Minimum="0" Maximum="100"
                                 Width="120" Height="4"
                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                 Background="#374151"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ LOADING OVERLAY ══════════════════════════════════════════════════ -->
        <controls:LoadingOverlay Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                                 Panel.ZIndex="100"/>
    </Grid>
</Window>
