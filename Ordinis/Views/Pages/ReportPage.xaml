<UserControl x:Class="Ordinis.Views.Pages.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource OrdinisBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Reports" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Export scan results in multiple formats. Reports are saved in the Reports folder next to Ordinis.exe."
                           FontSize="13" Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Status -->
            <Border Background="#1A2035" CornerRadius="6" Padding="14,10" Margin="0,0,0,20"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#93C5FD" FontSize="13"/>
            </Border>

            <WrapPanel Orientation="Horizontal" Margin="0,0,0,20">
                <!-- HTML -->
                <Border Style="{StaticResource CardStyle}" Width="260" Margin="0,0,16,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Web" Width="24" Height="24"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                     Margin="0,0,10,0"/>
                            <TextBlock Text="HTML Report" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Full interactive report with charts, filters, and collapsible finding details. Opens in browser."
                                   Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Command="{Binding GenerateHtmlCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource PrimaryHueMidBrush}"
                                HorizontalAlignment="Left" Padding="12,6">
                            Generate HTML
                        </Button>
                    </StackPanel>
                </Border>

                <!-- JSON -->
                <Border Style="{StaticResource CardStyle}" Width="260" Margin="0,0,16,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="CodeBraces" Width="24" Height="24"
                                                     Foreground="{StaticResource InfoBlue}"
                                                     Margin="0,0,10,0"/>
                            <TextBlock Text="JSON Report" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Machine-readable JSON output for SIEM integration, custom dashboards, or scripting."
                                   Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Command="{Binding GenerateJsonCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Left" Padding="12,6">
                            Generate JSON
                        </Button>
                    </StackPanel>
                </Border>

                <!-- CSV -->
                <Border Style="{StaticResource CardStyle}" Width="260" Margin="0,0,16,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="TableLarge" Width="24" Height="24"
                                                     Foreground="{StaticResource PassGreen}"
                                                     Margin="0,0,10,0"/>
                            <TextBlock Text="CSV Export" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Spreadsheet-compatible CSV with all findings. Import into Excel, Jira, or other tools."
                                   Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Command="{Binding GenerateCsvCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Left" Padding="12,6">
                            Generate CSV
                        </Button>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Foreground="#4B5563" FontSize="11" TextWrapping="Wrap">
                Reports are saved to the <Run FontFamily="Consolas" Foreground="#6B7280">Reports\</Run> folder
                in the Ordinis installation directory. Each report filename includes a timestamp.
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
