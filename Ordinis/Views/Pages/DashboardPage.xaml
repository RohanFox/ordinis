<UserControl x:Class="Ordinis.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Ordinis.Views.Controls"
             Background="{StaticResource OrdinisBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Dashboard" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock FontSize="13" Foreground="#6B7280" Margin="0,4,0,0">
                    <Run Text="Last scan: "/>
                    <Run Text="{Binding LastScanTime, Mode=OneWay}"/>
                    <Run Text="  ·  Target: "/>
                    <Run Text="{Binding ScanTarget, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <!-- No data placeholder -->
            <Border Background="{StaticResource OrdinisSurface}" CornerRadius="10" Padding="40"
                    Margin="0,0,0,20"
                    Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldSearch" Width="48" Height="48"
                                             Foreground="#374151" HorizontalAlignment="Center"
                                             Margin="0,0,0,12"/>
                    <TextBlock Text="No scan results yet." Foreground="#6B7280"
                               FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Click Run Audit to start a new scan."
                               Foreground="#4B5563" FontSize="13" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Compliance + summary cards -->
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,20"
                       Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- Donut chart -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                    <StackPanel HorizontalAlignment="Center">
                        <controls:DonutChart Percentage="{Binding CompliancePercent}" Margin="0,0,0,8"/>
                        <TextBlock Text="Overall Compliance"
                                   FontSize="12" Foreground="#6B7280"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Count cards -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16" MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="{Binding PassCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource PassGreen}" Margin="0,0,0,4"/>
                        <TextBlock Text="Passed" Foreground="#6B7280" FontSize="13" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalChecks, StringFormat='of {0} checks'}"
                                   Foreground="#4B5563" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16" MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="{Binding FailCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource FailRed}" Margin="0,0,0,4"/>
                        <TextBlock Text="Failed" Foreground="#6B7280" FontSize="13"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16" MinWidth="110">
                    <StackPanel>
                        <TextBlock Text="{Binding ErrorCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource WarnAmber}" Margin="0,0,0,4"/>
                        <TextBlock Text="Errors" Foreground="#6B7280" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- System Info card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="SYSTEM INFO" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#6B7280" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OS" Foreground="#6B7280" FontSize="12" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="{Binding OsName, Mode=OneWay}"
                                       Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="AV/EDR" Foreground="#6B7280" FontSize="12" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="{Binding AvProduct, Mode=OneWay}"
                                       Foreground="#D1D5DB" FontSize="12" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Severity breakdown + module breakdown side by side -->
            <Grid Visibility="{Binding HasData, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Severity breakdown -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Failed Findings by Severity" FontSize="14"
                                   FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Critical" Foreground="{StaticResource CriticalPurple}" FontSize="12" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="8" CornerRadius="4" Background="#2D1B69" Margin="8,0">
                                    <Border HorizontalAlignment="Left" Height="8" CornerRadius="4"
                                            Background="{StaticResource CriticalPurple}"
                                            Width="{Binding CriticalBarWidth}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding CriticalCount}" Foreground="{StaticResource CriticalPurple}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <TextBlock Text="High" Foreground="{StaticResource FailRed}" FontSize="12" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="8" CornerRadius="4" Background="#450A0A" Margin="8,0">
                                    <Border HorizontalAlignment="Left" Height="8" CornerRadius="4"
                                            Background="{StaticResource FailRed}"
                                            Width="{Binding HighBarWidth}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding HighCount}" Foreground="{StaticResource FailRed}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Medium" Foreground="{StaticResource WarnAmber}" FontSize="12" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="8" CornerRadius="4" Background="#451A03" Margin="8,0">
                                    <Border HorizontalAlignment="Left" Height="8" CornerRadius="4"
                                            Background="{StaticResource WarnAmber}"
                                            Width="{Binding MediumBarWidth}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding MediumCount}" Foreground="{StaticResource WarnAmber}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Low" Foreground="{StaticResource InfoBlue}" FontSize="12" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="8" CornerRadius="4" Background="#1E3A5F" Margin="8,0">
                                    <Border HorizontalAlignment="Left" Height="8" CornerRadius="4"
                                            Background="{StaticResource InfoBlue}"
                                            Width="{Binding LowBarWidth}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding LowCount}" Foreground="{StaticResource InfoBlue}" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Module breakdown -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Checks by Module" FontSize="14"
                                   FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Windows OS" Foreground="#D1D5DB" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding WindowsChecks}" Foreground="#9CA3AF" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <TextBlock Text="SQL Server" Foreground="#D1D5DB" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding SqlChecks}" Foreground="#9CA3AF" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Network / IPv6" Foreground="#D1D5DB" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding NetworkChecks}" Foreground="#9CA3AF" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Active Directory" Foreground="#D1D5DB" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding AdChecks}" Foreground="#9CA3AF" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
