<UserControl x:Class="Ordinis.Views.Pages.FindingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource OrdinisBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Findings" FontSize="22" FontWeight="SemiBold"
                   Foreground="White" Margin="0,0,0,16"/>

        <!-- Filter bar -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="240" Margin="0,0,12,4"
                         materialDesign:HintAssist.Hint="Search findings…"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Padding="8,4"/>
                <ComboBox ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding StatusFilter}"
                          Width="120" Margin="0,0,12,4"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Status"/>
                <ComboBox ItemsSource="{Binding SeverityOptions}"
                          SelectedItem="{Binding SeverityFilter}"
                          Width="130" Margin="0,0,12,4"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Severity"/>
                <ComboBox ItemsSource="{Binding ModuleOptions}"
                          SelectedItem="{Binding ModuleFilter}"
                          Width="150" Margin="0,0,0,4"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Module"/>
            </WrapPanel>
        </Border>

        <!-- Findings split: table left, detail right -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Findings table -->
            <Border Grid.Column="0" Background="{StaticResource OrdinisSurface}" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Displayed}"
                          SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#1F2235"
                          BorderThickness="0"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="10,8"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          Foreground="#D1D5DB">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="St" Width="38" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusIcon}"
                                               Foreground="{Binding StatusColor}"
                                               FontSize="16" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Sev" Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="5,2" HorizontalAlignment="Left">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1F2235"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding Severity}"
                                                   Foreground="{Binding SeverityColor}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100"
                                            ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                        <DataGridTextColumn Header="Module" Binding="{Binding ModuleLabel}" Width="100"
                                            ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"
                                            ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>

                        <DataGridTemplateColumn Header="Fix" Width="55" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.FixFindingCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsSafeToAutoFix, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                                            Padding="4,2" FontSize="11">
                                        <materialDesign:PackIcon Kind="Wrench" Width="14" Height="14"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Detail panel -->
            <Border Grid.Column="2" Background="{StaticResource OrdinisSurface}" CornerRadius="8"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <!-- Finding ID + name -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Selected.Id}"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                       FontSize="12" FontFamily="Consolas" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Selected.Name}"
                                       Foreground="White" FontSize="15"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Separator Background="#2A2A3E" Margin="0,0,0,12"/>

                        <!-- Key/value grid -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Status"    Foreground="#6B7280" FontSize="12"/>
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Selected.Status}"
                                       Foreground="{Binding Selected.StatusColor}" FontSize="12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Severity"  Foreground="#6B7280" FontSize="12" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Selected.Severity}"
                                       Foreground="{Binding Selected.SeverityColor}" FontSize="12" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Actual"    Foreground="#6B7280" FontSize="12" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding Selected.ActualValueDisplay}"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#F59E0B" Margin="0,8,0,0" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Expected"  Foreground="#6B7280" FontSize="12" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding Selected.ExpectedValue}"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#22C55E" Margin="0,8,0,0" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Benchmark" Foreground="#6B7280" FontSize="12" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       FontSize="12" Margin="0,8,0,0" Foreground="#9CA3AF">
                                <Run Text="{Binding Selected.Benchmark, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Selected.BenchmarkRef, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>

                        <Separator Background="#2A2A3E" Margin="0,0,0,12"/>

                        <!-- Description -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Description" Foreground="#6B7280" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Selected.Description}"
                                       Foreground="#9CA3AF" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>

                        <!-- WHY IT FAILED (only when status = Fail) -->
                        <Border Margin="0,0,0,12" Background="#2A1515" CornerRadius="4" Padding="10,8"
                                Visibility="{Binding Selected.FailureReason, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="WHY IT FAILED" Foreground="#EF4444" FontSize="10"
                                           FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Selected.FailureReason}"
                                           Foreground="#FCA5A5" FontFamily="Consolas"
                                           FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Check source -->
                        <StackPanel Margin="0,0,0,12"
                                    Visibility="{Binding Selected.CheckSource, Converter={StaticResource NotEmptyToVisibilityConverter}}">
                            <TextBlock Text="Source" Foreground="#6B7280" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Selected.CheckSource}"
                                       Foreground="#4B5563" FontFamily="Consolas"
                                       FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Remediation -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Remediation" Foreground="#6B7280" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Selected.RemediationText}"
                                       Foreground="#D1D5DB" FontSize="12"
                                       TextWrapping="Wrap" LineHeight="18"/>
                        </StackPanel>

                        <!-- Additional remediation steps -->
                        <StackPanel Margin="0,0,0,12"
                                    Visibility="{Binding Selected.RemediationSteps.Count, Converter={StaticResource IntToVisConverter}}">
                            <TextBlock Text="All Remediation Methods" Foreground="#6B7280" FontSize="10"
                                       FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Selected.RemediationSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1A1B2E" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding}" Foreground="#9CA3AF"
                                                       FontFamily="Consolas" FontSize="11"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Command="{Binding FixFindingCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource PrimaryHueMidBrush}"
                                    Padding="12,6" FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Wrench" Width="14" Height="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Apply Fix"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- No selection placeholder -->
            <Border Grid.Column="2" Background="{StaticResource OrdinisSurface}" CornerRadius="8"
                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CursorDefaultClick" Width="32" Height="32"
                                             Foreground="#374151" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Select a finding" Foreground="#4B5563" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
