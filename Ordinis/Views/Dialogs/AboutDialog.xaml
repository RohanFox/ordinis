<Window x:Class="Ordinis.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        Title="About Ordinis"
        Width="480" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource OrdinisSurface}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Style="{StaticResource MaterialDesignWindow}">
    <StackPanel Margin="40" VerticalAlignment="Center">

        <!-- Animated GIF -->
        <Image Width="80" Height="80"
               gif:AnimationBehavior.SourceUri="pack://application:,,,/Assets/loading.gif"
               gif:AnimationBehavior.RepeatBehavior="Forever"
               HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <TextBlock Text="ORDINIS"
                   FontSize="28" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <TextBlock Text="Microsoft Ecosystem Security &amp; Hardening Suite"
                   FontSize="13" Foreground="#9CA3AF"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Margin="0,0,0,8"/>

        <Separator Background="#2A2A3E" Margin="0,8"/>

        <Grid HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Foreground="#6B7280" FontSize="12"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="1.0.0" Foreground="#D1D5DB" FontSize="12"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="License" Foreground="#6B7280" FontSize="12" Margin="0,6,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="MIT — Free &amp; Open Source" Foreground="#D1D5DB" FontSize="12" Margin="0,6,0,0"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Author" Foreground="#6B7280" FontSize="12" Margin="0,6,0,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="RohanFox" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="12" Margin="0,6,0,0"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="GitHub" Foreground="#6B7280" FontSize="12" Margin="0,6,0,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Margin="0,6,0,0">
                <Hyperlink NavigateUri="https://github.com/RohanFox"
                           RequestNavigate="OnNavigate"
                           Foreground="{DynamicResource PrimaryHueMidBrush}">
                    github.com/RohanFox
                </Hyperlink>
            </TextBlock>
        </Grid>

        <Separator Background="#2A2A3E" Margin="0,8"/>

        <Button Content="Close" IsDefault="True" IsCancel="True"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Background="{DynamicResource PrimaryHueMidBrush}"
                HorizontalAlignment="Center" Padding="32,8"
                Click="OnClose"/>
    </StackPanel>
</Window>
