<Window x:Class="Ordinis.Views.Dialogs.FixDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Confirm Fix — Ordinis"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1A1B2E"
        TextElement.Foreground="White"
        FontFamily="Segoe UI"
        Style="{StaticResource MaterialDesignWindow}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionSep" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#2D2F4A"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,24,28,20">

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Border Background="#2D1B69" CornerRadius="6" Padding="8,4" Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding FindingId}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            </Border>
            <TextBlock Text="{Binding FindingName}" FontSize="16" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Change summary grid -->
        <Border Background="#22243A" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Method" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Method}" Style="{StaticResource ValueStyle}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Setting" Style="{StaticResource LabelStyle}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SettingPath}" Style="{StaticResource ValueStyle}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Current value" Style="{StaticResource LabelStyle}"/>
                <Border Grid.Row="4" Grid.Column="1" Background="#3B1E1E" CornerRadius="4" Padding="6,2"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding CurrentValue}" Foreground="#EF4444" FontFamily="Consolas"
                               FontSize="12"/>
                </Border>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="New value" Style="{StaticResource LabelStyle}"/>
                <Border Grid.Row="6" Grid.Column="1" Background="#1A3A1A" CornerRadius="4" Padding="6,2"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding NewValue}" Foreground="#22C55E" FontFamily="Consolas"
                               FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <!-- Status notices -->
        <StackPanel Margin="0,0,0,16">

            <!-- Backup notice -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16"
                                         Foreground="#22C55E" VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                <TextBlock Text="{Binding BackupDescription}" Foreground="#22C55E" FontSize="12"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Restart notice -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                        Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibilityConverter}}">
                <materialDesign:PackIcon Kind="Restart" Width="16" Height="16"
                                         Foreground="#F59E0B" VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                <TextBlock Text="A system restart may be required for this change to take effect."
                           Foreground="#F59E0B" FontSize="12" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Reversible notice -->
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16"
                                         Foreground="#3B82F6" VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                <TextBlock Foreground="#3B82F6" FontSize="12" VerticalAlignment="Center">
                    <Run Text="Reversible: "/>
                    <Run Text="{Binding ReversibleText, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Script preview (collapsible) -->
        <Expander Header="Preview fix script" Margin="0,0,0,20"
                  Foreground="#9CA3AF" FontSize="12">
            <Border Background="#12131F" CornerRadius="6" Padding="12" Margin="0,8,0,0"
                    MaxHeight="200">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ScriptPreview}"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="#D1D5DB" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </Expander>

        <!-- Action buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Cancel"
                    IsCancel="True"
                    Click="Cancel_Click"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Foreground="#6B7280"
                    HorizontalAlignment="Left"/>

            <Button Grid.Column="1"
                    Content="Apply Fix"
                    IsDefault="True"
                    Click="Apply_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    Padding="20,8"/>
        </Grid>

    </StackPanel>
</Window>
